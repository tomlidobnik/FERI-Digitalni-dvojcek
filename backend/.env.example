# API Configuration
API_TITLE=Digital Twin API
API_DESCRIPTION=Digital Twin API with Human Detection and Event Management
API_VERSION=1.0.0

# Server Configuration
HOST=0.0.0.0
PORT=8000
RELOAD=false

# JWT Configuration
JWT_SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Configuration
DATABASE_URL=sqlite:///app.db
DATABASE_PATH=./app.db

# Model Configuration
CHECKPOINT_PATH=checkpoints/human-detection-epoch=05-val_loss=0.63.ckpt
CONFIDENCE_THRESHOLD=0.88

# CORS Configuration
CORS_ORIGINS=*
CORS_CREDENTIALS=true
CORS_METHODS=*
CORS_HEADERS=*

# Logging
LOG_LEVEL=INFO

#!/usr/bin/env just --justfile

build:
    echo "Building blockchain_mpi..."
    mkdir -p build
    mpicxx -std=c++17 -O3 -march=native -Wall -Wextra -Xpreprocessor -fopenmp \
        -I/opt/homebrew/opt/openssl@3/include \
        -I/opt/homebrew/opt/libomp/include \
        -L/opt/homebrew/opt/openssl@3/lib \
        -L/opt/homebrew/opt/libomp/lib \
        main.cpp -o build/blockchain_mpi \
        -lssl -lcrypto -lomp
    echo "✓ Build complete: ./build/blockchain_mpi"

clean:
    echo "Cleaning build artifacts..."
    rm -rf build *.png *.txt
    echo "✓ Clean complete"

serve: build
    echo "Starting blockchain API on http://localhost:8001"
    uv run api.py

run: build
    echo "Running blockchain (threaded)..."
    ./build/blockchain_mpi

run-mpi N="4": build
    echo "Running blockchain with {{N}} MPI nodes..."
    mpirun -n {{N}} ./build/blockchain_mpi

benchmark: build
    echo "Running performance benchmark..."
    uv run performance_analysis.py

benchmark-full: build
    echo "Running comprehensive performance benchmark..."
    uv run performance_analysis_full.py

benchmark-mpi: build
    echo "Running MPI benchmark (1-8 nodes)..."
    uv run benchmark_mpi.py

benchmark-comprehensive: build
    echo "Running comprehensive nodes×threads benchmark..."
    uv run benchmark_nodes_threads.py
